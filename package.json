{
  "name": "playwright-atas",
  "version": "1.0.0",
  "type": "commonjs",
  "description": "JSON-driven test automation framework using Playwright",
  "main": "index.js",
  "bin": {
    "atas": "./bin/cli.js"
  },
  "scripts": {
    "test": "node index.js",
    "start": "node bin/cli.js run",
    "allure:generate": "allure generate ./allure-results -o ./allure-report --clean",
