          "action_config": {
            "url": "https://www.google.com"
          }
        },
        {
          "action_name": "ui_wait",
          "action_type": "ui",
          "action_config": {
            "wait_for": "seconds",
            "wait_seconds": 2
          }
        }
      ]
    }
  ]
